{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["namespaces", "demo"],
  "properties": {
    "namespaces": {
      "type": "object",
      "required": ["demo"],
      "properties": {
        "demo": {
          "type": "string",
          "minLength": 1,
          "title": "Demo namespace",
          "x-interactive-labs": { "kind": "namespace-name" }
        }
      }
    },
    "demo": {
      "type": "object",
      "required": ["password", "rootUrl"],
      "properties": {
        "password": {
          "type": "string",
          "minLength": 1,
          "x-interactive-labs": { "kind": "generated-password" }
        },
        "rootUrl": {
          "type": "string",
          "minLength": 1,
          "x-interactive-labs": {
            "kind": "root-url",
            "routeName": "sample",
            "namespaceRef": "demo"
          }
        }
      }
    }
  }
}
